@model List<Ecommerce.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add Category</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Parent Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Name</td>
                <td>@(cat.ParentCategory?.Name ?? "-")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
