@model List<Ecommerce.Models.Order>
@{
    ViewData["Title"] = "All Orders";
}

<h2>All Orders</h2>

<table class="table">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@(order.User?.FullName ?? order.UserId)</td>
                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge bg-info">@order.Status</span></td>
                <td>@order.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
