@page
@model Ecommerce.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h3 class="card-title fw-bold mb-1">Create account</h3>
                <p class="text-muted small mb-4">Already have one? <a asp-page="./Login">Sign in</a></p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label fw-medium">Full Name</label>
                        <input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Your full name" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-medium">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-medium">Password</label>
                        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" placeholder="Min 6 chars" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-medium">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Repeat password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Register</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
