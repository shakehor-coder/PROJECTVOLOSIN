@using Ecommerce.Models
@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var featured = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
}

<!-- Hero -->
<div class="p-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
    <div class="py-3">
        <h1 class="fw-bold display-5 mb-2">Welcome to ShopEase</h1>
        <p class="lead mb-4 text-white-50">Thousands of products across every category — all in one place.</p>
        <a class="btn btn-light btn-lg px-4" asp-controller="Catalog" asp-action="Index">Browse All Products</a>
    </div>
</div>

<!-- Categories -->
@if (categories.Any())
{
<section class="mb-5">
    <h4 class="mb-3 fw-semibold">Shop by Category</h4>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
        @foreach (var cat in categories)
        {
        <div class="col">
            <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.CategoryId"
               class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm text-center py-3 px-2 category-card">
                    <div class="card-body p-0">
                        <div class="mb-2 fs-2">&#128722;</div>
                        <p class="mb-0 small fw-medium text-dark">@cat.Name</p>
                    </div>
                </div>
            </a>
        </div>
        }
    </div>
</section>
}

<!-- Featured Products -->
@if (featured.Any())
{
<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold mb-0">New Arrivals</h4>
        <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none small">View all &rarr;</a>
    </div>
    <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var p in featured)
        {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card">
                <div class="card-body d-flex flex-column">
                    <p class="text-muted small mb-1">@(p.Category?.Name ?? "")</p>
                    <h6 class="card-title fw-semibold">@p.Name</h6>
                    <p class="mt-auto mb-2 fw-bold text-primary fs-5">$@p.Price.ToString("0.00")</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.ProductId"
                           class="btn btn-sm btn-outline-secondary flex-fill">Details</a>
                        <a asp-controller="Cart" asp-action="Add" asp-route-productId="@p.ProductId"
                           class="btn btn-sm btn-dark flex-fill">Add to Cart</a>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
</section>
}

@section Scripts {
<style>
    .category-card {
        transition: transform .15s, box-shadow .15s;
        cursor: pointer;
    }
    .category-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(0,0,0,.1) !important;
    }
    .product-card {
        transition: transform .15s, box-shadow .15s;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(0,0,0,.1) !important;
    }
</style>
}
