@using Ecommerce.Models
@{
    ViewData["Title"] = "Находки из другого мира";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var featured = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    var categoryNumber = 0;
}
<section class="void-hero" aria-labelledby="hero-title">
    <img class="hero-scene" src="~/images/void-scene.png" alt="" width="1670" height="941" fetchpriority="high" />
    <div class="hero-label">A LITTLE LOST. A LITTLE FOUND.</div>
    <div class="mascot-position" aria-hidden="true"><svg class="void-mascot" viewBox="360 210 800 620"><image href="@Url.Content("~/images/void-mascot.png")" width="1536" height="1024" /></svg></div>
    <div class="hero-copy"><p class="hero-eyebrow">ПОСЫЛКА ИЗ ДРУГОГО МИРА</p><h1 id="hero-title">VOID DELIVERY</h1><p class="hero-description">Вещи, которые нашли тебя.<br />Доставка, которая не потеряется.</p><a class="btn btn-dark hero-cta" asp-controller="Catalog" asp-action="Index">Открыть каталог <span aria-hidden="true">↗</span></a></div>
    <div class="hero-bottom"><span>EST. 2026</span><span>ПРОКРУТИ ВНИЗ ↓</span><span>GOOD FINDS ONLY</span></div>
</section>
<div class="void-ticker" aria-hidden="true"><span>НАХОДКИ СО ВСЕГО МИРА</span><b>✦</b><span>СОБРАНО С ЗАБОТОЙ</span><b>✦</b><span>ДОСТАВЛЕНО С МАГИЕЙ</span><b>✦</b></div>
@if (categories.Any())
{
<section class="void-section">
    <div class="section-heading"><div><span class="section-number">01 / EXPLORE</span><h2>Выбери свой мир</h2></div><p>У каждой находки — своё место.</p></div>
    <div class="category-grid">
    @foreach (var cat in categories)
    {
        categoryNumber++;
        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="category-tile"><span class="category-number">@categoryNumber.ToString("D2")</span><span>@cat.Name</span><span class="category-arrow" aria-hidden="true">↗</span></a>
    }
    </div>
</section>
}
@if (featured.Any())
{
<section class="void-section">
    <div class="section-heading"><div><span class="section-number">02 / NEW FINDS</span><h2>Только что из портала</h2></div><a class="text-link" asp-controller="Catalog" asp-action="Index">Все находки ↗</a></div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var p in featured)
    {
        <div class="col"><article class="card h-100 product-card"><partial name="_ProductArt" model="p" /><div class="card-body d-flex flex-column"><p class="product-category">@(p.Category?.Name ?? "")</p><h3 class="card-title h6">@p.Name</h3><p class="mt-auto mb-3 product-price">@p.Price.ToString("C")</p><div class="d-flex gap-2"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-secondary flex-fill">Details</a><a asp-controller="Cart" asp-action="Add" asp-route-productId="@p.ProductId" class="btn btn-sm btn-dark flex-fill">Add to Cart</a></div></div></article></div>
    }
    </div>
</section>
}
<section class="void-note"><span class="note-star" aria-hidden="true">✦</span><div><span class="section-number">FROM THE VOID, WITH LOVE</span><h2>Не просто вещи.<br />Твои будущие любимые.</h2></div><a class="btn btn-outline-dark" asp-controller="Catalog" asp-action="Index">Найти своё ↗</a></section>
