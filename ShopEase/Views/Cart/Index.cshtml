@model Ecommerce.ViewModels.CartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Shopping Cart</h2>

@if (!Model.Items.Any())
{
    <p>Your cart is empty.</p>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Browse Products</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="qty" value="@item.Quantity" min="1" class="form-control d-inline" style="width:80px" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                    </td>
                    <td>@item.LineTotal.ToString("C")</td>
                    <td>
                        <a asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-sm btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Total:</td>
                <td class="fw-bold">@Model.Total.ToString("C")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Checkout</a>
    </div>
}
