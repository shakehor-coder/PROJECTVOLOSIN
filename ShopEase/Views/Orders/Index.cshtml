@model List<Ecommerce.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<h2>Мои заказы</h2>
<p class="text-muted">Без аккаунта история доступна только в этом браузере, пока сохраняется сессия.</p>

@if (!Model.Any())
{
    <p>No orders yet.</p>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Browse Products</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge bg-info">@order.Status</span>
                    </td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
